{
  "name": "saucedemo-playwright-ts",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end test automation for saucedemo.com with Playwright and TypeScript",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:shuffle": "playwright test --shuffle --retries=0 --workers=1",
    "test:shuffle:parallel": "playwright test --shuffle --retries=0",
    "test:api": "playwright test --project=api",
    "test:visual": "playwright test --project=visual",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "allure": "3.33.0",
    "allure-playwright": "3.14.0",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "eslint-plugin-playwright": "2.12.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
