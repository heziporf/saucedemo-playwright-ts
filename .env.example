# Copy to .env to override. If .env is missing, these values are used.
# All saucedemo users share one public password, as published on the site.

BASE_URL=https://www.saucedemo.com

STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
PROBLEM_USER=problem_user
PERFORMANCE_GLITCH_USER=performance_glitch_user
ERROR_USER=error_user
VISUAL_USER=visual_user
PASSWORD=secret_sauce

# Public demo API used by the API test suite (saucedemo has no API)
API_BASE_URL=https://dummyjson.com
API_USERNAME=emilys
API_PASSWORD=emilyspass

# Milliseconds between actions, for watching a headed run. Keep 0 for normal runs.
SLOW_MO=0
